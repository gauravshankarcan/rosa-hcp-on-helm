# Copy to ./env and fill values. NEVER commit ./env.
# source ./env before local ansible runs.
#
# Local CRC hub example:
#   export OCP_CENTRAL_SERVER="https://api.crc.testing:6443"
#   export OCP_CENTRAL_USERNAME="kubeadmin"
#   export KUBECONFIG=$PWD/.kube/hub.kubeconfig
# ACM/AAP install manifests for CRC live under /tmp/rosa-crc-hub (not in git).

export OCP_CENTRAL_SERVER="https://api.crc.testing:6443"
export OCP_CENTRAL_USERNAME="kubeadmin"
export OCP_CENTRAL_PASSWORD=""

export AAP_URL="https://aap.example.com"
export AAP_USER="admin"
export AAP_PASSWORD=""

export AWS_ACCESS_KEY=""
export AWS_SECRET_KEY=""
export AWS_ACCOUNT=""

# Git write access for Ansible (commit/push cluster artifacts) and Argo CD
# Prefer a fine-scoped PAT/fine-grained token with contents:write on this repo.
# NEVER commit the real token — only ./env (gitignored).
export GIT_TOKEN=""

# Required for full ROSA HCP cloud create via CAPI (Ready path). Never commit real values.
# export OCM_TOKEN=""          # offline/API token from https://console.redhat.com/openshift/token
# export OCM_API_URL="https://api.openshift.com"
# After setting: ./scripts/ensure-ocm-secret.sh  (or let Ansible create from env)
# Optional marketplace billing account (may differ from AWS_ACCOUNT):
# export ROSA_BILLING_ACCOUNT=""

# Optional overrides
export ROSA_READINESS_TIMEOUT_MINUTES="90"
export ROSA_GIT_REPO_URL="https://github.com/gauravshankarcan/rosa-hcp-on-helm.git"
export ROSA_GIT_BRANCH="main"
