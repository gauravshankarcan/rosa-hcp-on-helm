# Thin spoke overrides — chart defaults remain the rich source of knobs.
---
karpenter:
  enabled: {{ (feature_flags | default([]) | intersect(['karpenter']) | length > 0) | lower }}
amqStreams:
  enabled: {{ (feature_flags | default([]) | intersect(['amq-stream']) | length > 0) | lower }}
workers:
  count: {{ node_count | int }}
  nodePools: []
  # Leave nodePools empty to use chart defaults scaled from count; populate for multi-pool overrides.
