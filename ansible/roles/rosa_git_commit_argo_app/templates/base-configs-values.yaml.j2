# Thin spoke overrides — chart defaults remain the rich source of knobs.
# Feature chart root `enabled` is set by Argo Application helm.values when the
# survey flag selects that chart (Application is only emitted if the flag is set).
# This file carries shared deltas (workers) for valueFiles merge.
---
workers:
  count: {{ node_count | int }}
  nodePools: []
  # Leave nodePools empty to use chart defaults scaled from count; populate for multi-pool overrides.
