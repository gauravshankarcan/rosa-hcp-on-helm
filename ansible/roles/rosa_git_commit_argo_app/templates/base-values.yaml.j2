# ROSA HCP deploy values for ACM/CAPI — generated by rosa_git_commit_argo_app
# Secrets must NOT appear in this file.
#
# ACM/CAPI source of truth for cluster objects: ./capi/rosa-hcp-cluster.yaml
# (rendered by rosa_apply_capi_cluster and synced by Argo Application rosa-<cluster>).
# This file carries survey-derived metadata consumed by operators and spoke Helm valueFiles.
---
clusterName: {{ cluster_name }}
clusterType: hcp
ocpVersion: "{{ ocp_version }}"
rosaOcpVersion: "{{ rosa_ocp_version | default(ocp_version) }}"
aws:
  accountId: "{{ aws_account_id }}"
  region: "{{ rosa_aws_region }}"
{% if rosa_billing_account | default('') | length > 0 %}
  billingAccount: "{{ rosa_billing_account }}"
{% endif %}
workers:
  count: {{ node_count | int }}
capi:
  manifestPath: capi/rosa-hcp-cluster.yaml
  namespace: "{{ rosa_capi_namespace | default('default') }}"
  identityRef:
    kind: "{{ rosa_aws_identity_kind | default('AWSClusterStaticIdentity') }}"
    name: "{{ rosa_aws_identity_name | default('rosa-static') }}"
labels:
  "{{ rosa_isolation_label_managed }}": "true"
  "{{ rosa_isolation_label_cluster }}": "{{ cluster_name }}"
managedCluster:
  labels:
    "{{ rosa_isolation_label_managed }}": "true"
    "{{ rosa_isolation_label_cluster }}": "{{ cluster_name }}"
featureFlags: {{ feature_flags | default([]) | to_json }}
