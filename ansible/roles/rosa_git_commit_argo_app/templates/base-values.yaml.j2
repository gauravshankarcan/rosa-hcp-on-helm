# ROSA HCP deploy values for ACM/CAPI — generated by rosa_git_commit_argo_app
# Secrets must NOT appear in this file.
---
clusterName: {{ cluster_name }}
clusterType: hcp
ocpVersion: "{{ ocp_version }}"
aws:
  accountId: "{{ aws_account_id }}"
  region: "{{ rosa_aws_region }}"
workers:
  count: {{ node_count | int }}
  # Chart/deploy defaults may expand to multiple node pools; survey sets a simple count.
labels:
  "{{ rosa_isolation_label_managed }}": "true"
  "{{ rosa_isolation_label_cluster }}": "{{ cluster_name }}"
managedCluster:
  labels:
    "{{ rosa_isolation_label_managed }}": "true"
    "{{ rosa_isolation_label_cluster }}": "{{ cluster_name }}"
